  resultJson String @default("{}") @db.LongText
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([status])
  @@index([kind])
  @@index([batchKey])
  @@index([updatedAt])
}

/// Content Engine lifecycle for generated/validated units (Phase 1).
enum ContentEngineLifecycle {
  DISCOVERED
  QUEUED
  GENERATING
  GENERATED
  VALIDATING
  NEEDS_REWRITE
  VALIDATED
  READY_FOR_REVIEW
  APPROVED
  READY_TO_PUBLISH
  PUBLISHED
  BLOCKED_SAFETY
  BLOCKED_COVERAGE
  BLOCKED_QUALITY
  BLOCKED_LOCALIZATION
  BLOCKED_IMAGE
  BLOCKED_DUPLICATE
  BLOCKED_CLAIM
  BLOCKED_SEO
  BLOCKED_AEO
  BLOCKED_GEO
  BLOCKED_WORDS
}

enum ContentEngineContentType {
  SERVICE
  SERVICE_LOCATION
  DIY
  BLOG
  CATEGORY
}

/// Desired corpus unit — deterministic; does not invent coverage.
model ContentEngineManifest {
  id               String                   @id @default(cuid())
  contentKey       String
  contentType      ContentEngineContentType
  locale           String                   @default("en")
  serviceSlug      String?
  locationSlug     String?
  diySlug          String?
  articleSlug      String?
  safetyClass      String?
  coverageRequired Boolean                  @default(false)
  required         Boolean                  @default(true)
  priority         Int                      @default(0)
  generationVersion String                  @default("2026.09.10")
  metaJson String @default("{}") @db.LongText
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  validations      ContentEngineValidation[]
  runs             ContentEngineRunItem[]

  @@unique([contentKey, locale, generationVersion])
  @@index([contentType])
  @@index([priority])
}

model ContentEngineValidation {
  id         String                 @id @default(cuid())
  manifestId String
  passed     Boolean                @default(false)
  lifecycle  ContentEngineLifecycle @default(VALIDATING)
  scoreJson String @default("{}") @db.LongText
  issuesJson String @default("[]") @db.LongText
  wordCount  Int                    @default(0)
  createdAt  DateTime               @default(now())
  manifest   ContentEngineManifest  @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@index([manifestId, createdAt])
  @@index([passed])
}

model ContentEngineBatch {
  id                String   @id @default(cuid())
  batchKey          String   @unique
  generationVersion String
  size              Int
  status            String   @default("pending")
  startedAt         DateTime?
  finishedAt        DateTime?
  costEstimateUsd   Float    @default(0)
  metaJson String @default("{}") @db.LongText
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  items             ContentEngineRunItem[]
}

model ContentEngineRunItem {
  id         String                  @id @default(cuid())
  batchId    String
  manifestId String
  lifecycle  ContentEngineLifecycle  @default(QUEUED)
  attempt    Int                     @default(0)
  error String? @db.Text
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  batch      ContentEngineBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  manifest   ContentEngineManifest   @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([batchId, manifestId])
  @@index([lifecycle])
}

/// Editable public site chrome (home / header / footer). EN+AR JSON payloads.
/// When status=published, public pages prefer these over hardcoded message defaults.
model SiteShellDocument {
  id          String        @id @default(cuid())
  section     String        @unique
  status      ContentStatus @default(draft)
  payloadEn String @default("{}") @db.LongText
  payloadAr String @default("{}") @db.LongText
  updatedBy   String        @default("system")
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

