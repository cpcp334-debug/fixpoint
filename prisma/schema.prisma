generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  draft
  review
  published
  archived
}

enum ServiceStatus {
  draft
  active
  requires_approval
  subcontracted
  unavailable
  archived
}

enum LocationType {
  country
  emirate
  city
  community
}

enum LocationStatus {
  draft
  active
  archived
}

enum ServiceLocationLifecycle {
  draft
  review
  approved
  published
  archived
}

enum ServiceLocationQualityStatus {
  incomplete
  ready_for_review
  approved
  publishable
  indexable
  failed_quality
}

enum ServiceLocationRevisionStatus {
  draft
  approved
  published
  superseded
}

enum RiskLevel {
  green
  yellow
  red
}

enum DiyProfileStatus {
  draft
  safety_review
  translation_review
  approved
  published
  archived
}

enum DiyArabicReviewStatus {
  not_started
  translation_review
  ready_for_translation
  reviewed
}

enum QuoteMethod {
  fixed
  per_hour
  per_item
  per_unit
  per_sqft
  per_sqm
  per_room
  material_labor
  project
  inspection
  amc
}

enum LeadStatus {
  NEW
  QUALIFIED
  INSPECTION
  QUOTATION
  QUOTATION_SENT
  FOLLOW_UP
  APPROVED
  SCHEDULED
  COMPLETED
  LOST
  CANCELLED
}

enum BookingStatus {
  requested
  pending_confirmation
  confirmed
  assigned
  in_progress
  completed
  cancelled
  rescheduled
}

enum BookingType {
  standard
  site_inspection
  emergency
  recurring_cleaning
  amc_visit
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  FLAGGED
  VERIFIED
}

enum ReviewType {
  service
  article
  guide
}

enum KnowledgeScope {
  PUBLIC
  INTERNAL
  PRIVATE
}

enum KnowledgeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum StaffRole {
  admin
  manager
  customer_service
  sales
  supervisor
  technician
  subcontractor
  customer
}

enum LeadQualityClass {
  HOT
  WARM
  NORMAL
  REVIEW
  SPAM
}

enum LeadScoreCause {
  SYSTEM
  OVERRIDE
  RECOMPUTE
}

model ServiceCategory {
  id        String         @id @default(cuid())
  slug      String         @unique
  sopCode   String?
  sortOrder Int            @default(0)
  status    ContentStatus  @default(draft)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  translations ServiceCategoryI18n[]
  services  Service[]
}

model ServiceCategoryI18n {
  id          String          @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String @default("") @db.Text
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Service {
  id                   String        @id @default(cuid())
  categoryId           String
  slug                 String        @unique
  serviceType          String
  status               ServiceStatus @default(draft)
  riskLevel            RiskLevel     @default(yellow)
  diyAvailable         Boolean       @default(false)
  quoteMethod          QuoteMethod   @default(inspection)
  inspectionRequired   Boolean       @default(true)
  bookingEnabled       Boolean       @default(true)
  emergencyAvailable   Boolean       @default(false)
  amcAvailable         Boolean       @default(false)
  indexable            Boolean       @default(false)
  heroImage            String?
  gallery String @default("[]") @db.LongText
  relatedServiceSlugs String @default("[]") @db.LongText
  aiIntakeQuestions String @default("[]") @db.LongText
  schemaData String @default("{}") @db.LongText
  sopCode              String?
  sopPublic            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  category             ServiceCategory @relation(fields: [categoryId], references: [id])
  translations         ServiceI18n[]
  serviceLocations     ServiceLocation[]
  diyGuides            DiyGuide[]        @relation("ServiceDiyGuides")
  faqs                 Faq[]
  reviews              Review[]
  questions            Question[]
  leads                Lead[]
  bookings             Booking[]
  workOrders           WorkOrder[]
  quotes               Quote[]
  primaryDiyGuideId    String?
  primaryDiyGuide      DiyGuide?         @relation("ServicePrimaryDiyGuide", fields: [primaryDiyGuideId], references: [id], onDelete: SetNull)
}

model ServiceI18n {
  id                    String  @id @default(cuid())
  serviceId             String
  locale                String
  name                  String
  shortDescription String @db.Text
  longDescription String @db.LongText
  whoItIsFor String @default("") @db.Text
  whatWeDo String @default("") @db.LongText
  whenProfessional String @default("") @db.Text
  process String @default("") @db.LongText
  pricingInfo String @default("") @db.Text
  professionalFallback String @db.Text
  safetyNotes String @default("") @db.Text
  seoTitle String @db.Text
  metaDescription String @db.Text
  keywords String @default("") @db.Text
  faq String @default("[]") @db.LongText
  service               Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model Location {
  id          String         @id @default(cuid())
  slug        String         @unique
  type        LocationType
  parentId    String?
  status      LocationStatus @default(draft)
  serves      Boolean        @default(false)
  indexable   Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      Location?      @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[]     @relation("LocationTree")
  translations LocationI18n[]
  serviceLocations ServiceLocation[]
  faqs        Faq[]
  reviews     Review[]
  questions   Question[]
  leads       Lead[]
  bookings    Booking[]
  cityBookings Booking[] @relation("BookingCity")
  areaBookings Booking[] @relation("BookingArea")
  workOrders  WorkOrder[]
  quotes      Quote[]
}

model LocationI18n {
  id                 String   @id @default(cuid())
  locationId         String
  locale             String
  name               String
  intro String @db.LongText
  localServiceInfo String @default("") @db.LongText
  propertyTypes String @default("") @db.Text
  nearbyAreas String @default("") @db.Text
  seoTitle String @db.Text
  metaDescription String @db.Text
  faq String @default("[]") @db.LongText
  location           Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, locale])
}

model ServiceLocation {
  id                         String                        @id @default(cuid())
  serviceId                  String
  locationId                 String
  indexable                  Boolean                       @default(false)
  qualityScore               Int                           @default(0)
  covered                    Boolean                       @default(false)
  coverageStatus             ServiceLocationLifecycle      @default(draft)
  qualityStatus              ServiceLocationQualityStatus  @default(incomplete)
  indexableEn                Boolean                       @default(false)
  indexableAr                Boolean                       @default(false)
  bookingEnabledOverride     Boolean?
  amcAvailableOverride       Boolean?
  emergencyAvailableOverride Boolean?
  diyRestricted              Boolean                       @default(false)
  heroImageOverride          String?
  publishedAt                DateTime?
  approvedAt                 DateTime?
  approvedBy                 String?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  service                    Service                       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location                   Location                      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  translations               ServiceLocationI18n[]
  revisions                  ServiceLocationRevision[]

  @@unique([serviceId, locationId])
  @@index([coverageStatus, indexable])
  @@index([indexable, updatedAt])
  @@index([locationId, coverageStatus])
  @@index([serviceId, coverageStatus])
  @@index([qualityStatus])
}

model ServiceLocationI18n {
  id                String          @id @default(cuid())
  serviceLocationId String
  locale            String
  intro String @db.LongText
  localInfo String @db.LongText
  seoTitle String @db.Text
  metaDescription String @db.Text
  faq String @default("[]") @db.LongText
  h1 String @default("") @db.Text
  body String @default("") @db.LongText
  directAnswer String @default("") @db.Text
  geoIntro String @default("") @db.Text
  imageAlt String @default("") @db.Text
  serviceLocation   ServiceLocation @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)

  @@unique([serviceLocationId, locale])
}

model ServiceLocationRevision {
  id                 String                         @id @default(cuid())
  serviceLocationId  String
  revisionNumber     Int
  locale             String
  snapshotJson String @db.LongText
  generatedBy        String                         @default("system")
  approvedBy         String?
  approvedAt         DateTime?
  changeReason String @default("") @db.Text
  previousRevisionId String?
  status             ServiceLocationRevisionStatus  @default(draft)
  createdAt          DateTime                       @default(now())
  serviceLocation    ServiceLocation                @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)

  @@unique([serviceLocationId, locale, revisionNumber])
  @@index([serviceLocationId, status])
  @@index([serviceLocationId, locale, status])
}

model DiyCategory {
  id           String             @id @default(cuid())
  slug         String             @unique
  status       ContentStatus      @default(draft)
  indexable    Boolean            @default(false)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  translations DiyCategoryI18n[]
  guides       DiyGuide[]
}

model DiyCategoryI18n {
  id              String      @id @default(cuid())
  categoryId      String
  locale          String
  name            String
  description String @default("") @db.Text
  seoTitle String @default("") @db.Text
  metaDescription String @default("") @db.Text
  category        DiyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model DiyGuide {
  id                  String                 @id @default(cuid())
  slug                String                 @unique
  categoryId          String
  categorySlug        String
  serviceId           String?
  difficulty          String
  estimatedTime       String
  riskLevel           RiskLevel              @default(green)
  schemaType          String                 @default("article")
  status              ContentStatus          @default(draft)
  indexable           Boolean                @default(false)
  relatedSlugs String @default("[]") @db.LongText
  relatedServiceSlugs String @default("[]") @db.LongText
  locationSlugs String @default("[]") @db.LongText
  profileJson String @default("{}") @db.LongText
  profileStatus       DiyProfileStatus       @default(draft)
  profileVersion      Int                    @default(1)
  isPrimary           Boolean                @default(false)
  arabicReviewStatus  DiyArabicReviewStatus  @default(not_started)
  safetyReviewedBy    String?
  safetyReviewedAt    DateTime?
  createdBy           String                 @default("system")
  updatedBy           String                 @default("system")
  publishedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  category            DiyCategory            @relation(fields: [categoryId], references: [id])
  service             Service?               @relation("ServiceDiyGuides", fields: [serviceId], references: [id])
  primaryForServices  Service[]              @relation("ServicePrimaryDiyGuide")
  translations        DiyGuideI18n[]
  votes               DiyVote[]
  reviews             Review[]
  questions           Question[]

  @@index([serviceId, isPrimary])
  @@index([profileStatus])
}

model DiyGuideI18n {
  id                   String   @id @default(cuid())
  guideId              String
  locale               String
  title String @db.Text
  problem String @db.Text
  quickAnswer String @db.Text
  difficulty           String   @default("")
  estimatedTime        String   @default("")
  tools String @default("[]") @db.LongText
  materials String @default("[]") @db.LongText
  safety String @db.LongText
  steps String @default("[]") @db.LongText
  checkWork String @default("") @db.Text
  whenToStop String @db.Text
  professionalFallback String @db.Text
  seoTitle String @db.Text
  metaDescription String @db.Text
  faq String @default("[]") @db.LongText
  guide                DiyGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, locale])
}

model DiyVote {
  id        String   @id @default(cuid())
  guideId   String
  helpful   Boolean
  createdAt DateTime @default(now())
  guide     DiyGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

model Article {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  status               ContentStatus @default(draft)
  indexable            Boolean       @default(false)
  /** JSON string array of category slugs */
  categorySlugs String @default("[]") @db.LongText
  heroImage            String?
  /** JSON string array of service slugs */
  relatedServiceSlugs String @default("[]") @db.LongText
  /** JSON string array of DIY guide slugs */
  relatedDiySlugs String @default("[]") @db.LongText
  publishedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  translations         ArticleI18n[]
  reviews              Review[]
  questions            Question[]
}

model ArticleI18n {
  id              String  @id @default(cuid())
  articleId       String
  locale          String
  title String @db.Text
  excerpt String @default("") @db.Text
  body String @default("") @db.LongText
  diySection String @default("") @db.LongText
  faq String @default("[]") @db.LongText
  imageAlt String @default("") @db.Text
  seoTitle String @db.Text
  metaDescription String @db.Text
  article         Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
}

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique
  serviceSlug  String?
  locationSlug String?
  propertyType String?
  workDate     DateTime?
  status       ContentStatus @default(draft)
  indexable    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations ProjectI18n[]
}

model ProjectI18n {
  id              String  @id @default(cuid())
  projectId       String
  locale          String
  title String @db.Text
  problem String @default("") @db.Text
  scope           String  @default("")
  work String @default("") @db.Text
  result String @default("") @db.Text
  testimonial String @default("") @db.Text
  seoTitle String @db.Text
  metaDescription String @db.Text
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model Faq {
  id         String        @id @default(cuid())
  serviceId  String?
  locationId String?
  sortOrder  Int           @default(0)
  status     ContentStatus @default(published)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  service    Service?      @relation(fields: [serviceId], references: [id])
  location   Location?     @relation(fields: [locationId], references: [id])
  translations FaqI18n[]
}

model FaqI18n {
  id     String @id @default(cuid())
  faqId  String
  locale String
  question String @db.Text
  answer String @db.Text
  faq      Faq    @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
}

model MediaAsset {
  id             String          @id @default(cuid())
  storageKey     String          @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  alt String @default("") @db.Text
  caption String @default("") @db.Text
  visibility     String          @default("private")
  status         String          @default("ready")
  conversationId String?
  createdAt      DateTime        @default(now())
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
}

model Customer {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  whatsapp           String?
  email              String?
  preferredLanguage  String   @default("en")
  consentMarketing   Boolean  @default(false)
  notes String @default("") @db.Text
  visitorId          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  visitor            Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  properties         Property[]
  leads              Lead[]
  quotes             Quote[]
  bookings           Booking[]
  workOrders         WorkOrder[]
  invoices           Invoice[]
  reviews            Review[]
  amcContracts       AmcContract[]

  @@index([visitorId])
}

model Property {
  id         String   @id @default(cuid())
  customerId String
  locationId String?
  type       String
  notes String @default("") @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Lead {
  id              String     @id @default(cuid())
  source          String
  customerId      String?
  name            String
  phone           String
  email           String?
  whatsapp        String?
  serviceId       String?
  locationId      String?
  propertyType    String?
  city            String?
  area            String?
  requirement     String
  urgency         String     @default("normal")
  estimatedValue  String?
  status          LeadStatus @default(NEW)
  assignedStaffId String?
  photos String @default("[]") @db.LongText
  aiSummary       String     @default("")
  notes String @default("") @db.Text
  preferredDate   String?
  preferredTime   String?
  locale          String     @default("en")
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  gclid           String?
  gbraid          String?
  wbraid          String?
  landingPath     String?    @db.Text
  visitorId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  customer        Customer?  @relation(fields: [customerId], references: [id])
  service         Service?   @relation(fields: [serviceId], references: [id])
  location        Location?  @relation(fields: [locationId], references: [id])
  visitor         Visitor?   @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  score           LeadScore?
  bookings        Booking[]
  quotes          Quote[]

  @@index([visitorId])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@index([serviceId])
  @@index([locationId])
  @@index([gclid])
  @@index([utmSource])
}

model LeadScore {
  id             String           @id @default(cuid())
  leadId         String           @unique
  score          Int
  systemClass    LeadQualityClass
  humanClass     LeadQualityClass?
  effectiveClass LeadQualityClass
  reasonsJson String @default("[]") @db.LongText
  modelVersion   String           @default("2f2.1")
  computedAt     DateTime         @default(now())
  overrideAt     DateTime?
  overrideBy     String?
  overrideNote   String           @default("")
  quarantined    Boolean          @default(false)
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  history        LeadScoreHistory[]

  @@index([effectiveClass])
  @@index([quarantined])
}

model LeadScoreHistory {
  id             String           @id @default(cuid())
  leadScoreId    String
  leadId         String
  score          Int
  systemClass    LeadQualityClass
  effectiveClass LeadQualityClass
  reasonsJson String @default("[]") @db.LongText
  actor          String
  cause          LeadScoreCause
  note           String           @default("")
  createdAt      DateTime         @default(now())
  scoreRow       LeadScore        @relation(fields: [leadScoreId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Quote {
  id                  String      @id @default(cuid())
  quoteNumber         String      @unique
  status              QuoteStatus @default(DRAFT)
  customerId          String?
  leadId              String?
  serviceId           String?
  locationId          String?
  createdByUserId     String?
  locationLabel       String      @default("")
  serviceLabel        String      @default("")
  customerName        String      @default("")
  customerPhone       String      @default("")
  customerEmail       String?
  scope               String      @default("")
  materials String @default("") @db.LongText
  labor String @default("") @db.Text
  exclusions String @default("") @db.Text
  taxesNote String @default("") @db.Text
  validity String @default("") @db.Text
  paymentTerms String @default("") @db.Text
  estimatedDuration String @default("") @db.Text
  warrantyTerms String @default("") @db.Text
  notes String @default("") @db.Text
  subtotalLabel String @default("") @db.Text
  discountLabel String @default("") @db.Text
  taxLabel String @default("") @db.Text
  totalLabel String @default("") @db.Text
  humanApproved       Boolean     @default(false)
  sentAt              DateTime?
  sourceKey           String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  customer            Customer?   @relation(fields: [customerId], references: [id])
  lead                Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  service             Service?    @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location            Location?   @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items               QuoteItem[]
  invoices            Invoice[]

  @@index([leadId])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@index([serviceId])
  @@index([locationId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  description String @db.Text
  quantity    String @default("1")
  unit        String @default("")
  unitPrice   String @default("")
  lineTotal   String @default("")
  kind        String @default("item")
  sortOrder   Int    @default(0)
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  status          InvoiceStatus @default(DRAFT)
  customerId      String?
  quoteId         String?
  bookingId       String?
  workOrderId     String?
  createdByUserId String?
  customerName    String        @default("")
  customerPhone   String        @default("")
  customerEmail   String?
  locationLabel   String        @default("")
  serviceLabel    String        @default("")
  notes String @default("") @db.Text
  subtotalLabel String @default("") @db.Text
  discountLabel String @default("") @db.Text
  taxLabel String @default("") @db.Text
  totalLabel String @default("") @db.Text
  issueDate       String?
  dueDate         String?
  paymentRef      String?
  sourceKey       String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer?     @relation(fields: [customerId], references: [id])
  quote           Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  payments        Payment[]
  items           InvoiceItem[]

  @@index([customerId])
  @@index([quoteId])
  @@index([bookingId])
  @@index([workOrderId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String @db.Text
  quantity    String  @default("1")
  unit        String  @default("")
  unitPrice   String  @default("")
  lineTotal   String  @default("")
  kind        String  @default("item")
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PricingRule {
  id          String      @id @default(cuid())
  name        String
  serviceId   String?
  method      QuoteMethod @default(inspection)
  unitLabel   String      @default("")
  notes String @default("") @db.Text
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("customer_service")
  staffId       String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  staffAiConversations StaffAiConversation[]
  staffAiProposals     StaffAiProposal[]
  staffAiDailyUsage    StaffAiDailyUsage[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
