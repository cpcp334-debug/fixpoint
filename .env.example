# Public site URL used for canonical tags, Open Graph, and sitemaps.
SITE_URL="http://localhost:3000"

# Required. PostgreSQL connection string (same schema for local and production).
# Production / Docker Compose example:
# DATABASE_URL="postgresql://alnajah:alnajah@127.0.0.1:5432/alnajah?sslmode=require"
#
# Local PGlite (npm run pg) — pgbouncer=true and connection_limit=1 are PGlite-only.
# Do not copy those query params onto a real Postgres or pooler URL unless you actually use PgBouncer.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"

# OpenAI — server-side only. Leave empty to run the AI failsafe (no invented answers).
# Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Private AI photo uploads (bytes). Default 5 MB.
AI_UPLOAD_MAX_BYTES="5242880"

# Staff bootstrap for Phase 2E. Used by prisma seed to upsert one super_admin.
# Password must be at least 12 characters. Leave empty to skip creating a login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional analytics IDs — do not collect extra personal data.
# NEXT_PUBLIC_GA_ID=""
