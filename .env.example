# =============================================================================
# DEVELOPMENT
# =============================================================================
SITE_URL="http://localhost:3000"

# Preferred local (MySQL parity with Hostinger) — Docker MySQL or local MySQL 8:
# DATABASE_URL="mysql://alnajah:change-me@127.0.0.1:3306/alnajah"

# Legacy local PGlite / Postgres (npm run pg) — DEPRECATED for Hostinger MySQL path.
# Prisma schema is now provider=mysql; these URLs will not work with `prisma generate`
# unless you temporarily switch the schema back. Prefer Docker MySQL above.
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"

# =============================================================================
# REQUIRED PRODUCTION (Hostinger MySQL)
# =============================================================================
# NODE_ENV=production
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# SITE_URL="https://fixpoint.ae"
# ADMIN_EMAIL="ops@example.com"
# ADMIN_PASSWORD="use-a-long-unique-password"
# AUTOMATION_CRON_SECRET="min-16-chars-unique-cron-secret"
# HEALTH_CHECK_SECRET="min-16-chars-unique-health-secret"
# DOWNLOAD_CSRF_SECRET="min-32-chars-unique-download-csrf-secret"
# OPENAI_API_KEY="sk-..."
# Optional: SKIP_PRISMA_MIGRATE=1
#
# Neon → MySQL ETL (one-time, from a trusted machine — never commit):
# NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# FORCE_MYSQL_IMPORT=1   # only if re-importing into a non-empty MySQL DB
# MYSQL_IMPORT_PRIORITY=1  # skip ServiceLocation* (~124k) for fast bootstrap
# RUN_MYSQL_IMPORT=1       # Hostinger postdeploy only — temporary; remove after import
#
# Production startup requires mysql:// and refuses PGlite fingerprints.
# Rare local prod smoke test only:
# ALLOW_PRODUCTION_LOCAL_DB=1

# =============================================================================
# OPTIONAL
# =============================================================================
# OPENAI_MODEL="gpt-4o-mini"
# COFOUNDER_MODEL="gpt-4o-mini"
# COFOUNDER_DAILY_CHAT_LIMIT="100"
# AI_UPLOAD_MAX_BYTES="5242880"
# NEXT_PUBLIC_GA_ID=""
# AUTOMATION_EMAIL_PROVIDER=""
# AUTOMATION_WHATSAPP_PROVIDER=""

ADMIN_EMAIL=""
ADMIN_PASSWORD=""

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

AUTOMATION_CRON_SECRET=""
# AUTOMATION_STALE_RUNNING_MINUTES="15"

HEALTH_CHECK_SECRET=""
DOWNLOAD_CSRF_SECRET=""

# AUTH_LOCKOUT_THRESHOLD="5"
# AUTH_LOCKOUT_MINUTES="15"
# TRUST_PROXY="1"
# TRUSTED_PROXY_HOPS="1"

# Seed safety:
# - NODE_ENV=production → safe bootstrap only (no operational-data wipe).
# - SEED_STAFF_ONLY=1 → bootstrap only in any environment.
# ALLOW_DESTRUCTIVE_PRODUCTION_SEED="I_UNDERSTAND_DELETE_ALL_OPERATIONAL_DATA"

# =============================================================================
# BACKUP / DISASTER RECOVERY (comment-only — NOT CONFIGURED in-repo)
# =============================================================================
# See docs/disaster-recovery.md
# Hostinger MySQL backups: use Hostinger backup products / external dumps.
# Do NOT put secrets here.
