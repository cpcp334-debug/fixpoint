# =============================================================================
# DEVELOPMENT (local defaults)
# =============================================================================
# Public site URL used for canonical tags, Open Graph, and sitemaps.
SITE_URL="http://localhost:3000"

# Local PGlite (npm run pg) — pgbouncer=true and connection_limit=1 are PGlite-only.
# Do not copy this URL or those query params into production.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"

# Optional Docker Compose Postgres (development-only — see docker-compose.yml):
# DATABASE_URL="postgresql://alnajah_dev:change-me-dev-only@127.0.0.1:5432/alnajah_dev"

# =============================================================================
# REQUIRED PRODUCTION
# =============================================================================
# NODE_ENV=production
# DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"
# SITE_URL="https://www.example.com"
# ADMIN_EMAIL="ops@example.com"
# ADMIN_PASSWORD="use-a-long-unique-password"
# AUTOMATION_CRON_SECRET="min-16-chars-unique-cron-secret"
# HEALTH_CHECK_SECRET="min-16-chars-unique-health-secret"
# DOWNLOAD_CSRF_SECRET="min-32-chars-unique-download-csrf-secret"
# OPENAI_API_KEY="sk-..."
#
# Production startup refuses localhost / PGlite fingerprints.
# Rare local prod smoke test only (still never allows PGlite):
# ALLOW_PRODUCTION_LOCAL_DB=1

# =============================================================================
# OPTIONAL
# =============================================================================
# OPENAI_MODEL="gpt-4o-mini"
# COFOUNDER_MODEL="gpt-4o-mini"
# COFOUNDER_DAILY_CHAT_LIMIT="100"
# AI_UPLOAD_MAX_BYTES="5242880"
# NEXT_PUBLIC_GA_ID=""
# AUTOMATION_EMAIL_PROVIDER=""
# AUTOMATION_WHATSAPP_PROVIDER=""

# Staff bootstrap (safe seed upsert). Password must be at least 12 characters.
# Leave empty to skip creating a login during seed.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# OpenAI — server-side only. Leave empty to run the AI failsafe (no invented answers).
# Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Phase 2F.5 automation tick. POST /api/internal/automation/tick requires this secret (min 16 chars).
AUTOMATION_CRON_SECRET=""

# FIX 7: stale running job lease (minutes). Default 15, minimum 5. See docs/automation-reaper.md
# AUTOMATION_STALE_RUNNING_MINUTES="15"

# Authenticated DB health: GET /api/internal/health/db (min 16 chars). Do not reuse AUTOMATION_CRON_SECRET.
HEALTH_CHECK_SECRET=""

# Admin PDF/export CSRF (FIX 6). Min 32 chars. Fail closed in production if missing. Never log.
# See docs/security-headers-downloads.md
DOWNLOAD_CSRF_SECRET=""

# Staff login lockout (FIX 4). Defaults: 5 failures / 15 minutes.
# AUTH_LOCKOUT_THRESHOLD="5"
# AUTH_LOCKOUT_MINUTES="15"
# Optional SiteSetting.json keys: authLockoutThreshold, authLockoutMinutes

# Trusted proxy for rate-limit client IP (FIX 5). See docs/rate-limiting.md
# When unset: ignore X-Forwarded-For / X-Real-IP → "unknown"
# TRUST_PROXY="1"
# TRUSTED_PROXY_HOPS="1"

# Seed safety:
# - NODE_ENV=production → safe bootstrap only (no operational-data wipe).
# - SEED_STAFF_ONLY=1 → bootstrap only in any environment (skip catalog wipe).
# - Emergency ONLY (never routine deploys/CI):
# ALLOW_DESTRUCTIVE_PRODUCTION_SEED="I_UNDERSTAND_DELETE_ALL_OPERATIONAL_DATA"

# =============================================================================
# BACKUP / DISASTER RECOVERY (comment-only — NOT CONFIGURED in-repo)
# =============================================================================
# See docs/disaster-recovery.md
# Locked objectives: RPO ≤ 1 hour · RTO ≤ 4 hours
# PostgreSQL backups / PITR: REQUIRES EXTERNAL PROVIDER (Provider TBD)
# Private uploads: durable private object storage — REQUIRES EXTERNAL PROVIDER
#   (application still uses local uploads/private until a later migration)
# Do NOT set fake status flags. Do NOT put secrets here.
# Do NOT use same-server dumps as the production backup system.
# BACKUP_PROVIDER=          # TBD — set only in secrets manager when chosen
# BACKUP_RETENTION=         # TBD until provider selected
#
# -----------------------------------------------------------------------------
# Object storage adapter (see docs/object-storage.md) — NOT CONFIGURED for S3
# -----------------------------------------------------------------------------
# STORAGE_PROVIDER=local
# LOCAL_STORAGE_ROOT=uploads/private
# OBJECT_STORAGE_PROVIDER=          # TBD — set only when a real provider is wired
# OBJECT_STORAGE_BUCKET=            # TBD — private bucket; never commit credentials
# OBJECT_STORAGE_REGION=            # TBD
# OBJECT_STORAGE_ACCESS_KEY_ID=     # TBD — secrets manager only
# OBJECT_STORAGE_SECRET_ACCESS_KEY= # TBD — secrets manager only
# OBJECT_STORAGE_ENDPOINT=          # optional S3-compatible endpoint
# OBJECT_STORAGE_FORCE_PATH_STYLE=  # optional true/false
