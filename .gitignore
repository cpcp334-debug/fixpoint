# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files / secrets
.env
.env.*
!.env.example
*.pem
secrets/
**/secrets/
*.key
*.p12
credentials.json
service-account*.json

# local databases
/prisma/dev.db
/prisma/dev.db-journal
/prisma/pgdata
/prisma/pgdata-corrupt-*
/src/generated
/uploads/
/logs/

# SQL dumps & data exports (keep Prisma migration SQL)
*.sql
!prisma/migrations/**/*.sql
*.dump
*.sql.gz
*.dump.gz

# Hostinger / deploy artifacts (binaries + dumps)
/deploy/tools/
/deploy/out/
/deploy/out/*.dump
*.zip

# large / native binaries
*.exe
*.dll
*.bin
*.so
*.dylib

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
